# Application
NODE_ENV=development
APP_ENV=development

# Database
# Local Docker Compose maps Postgres to host port 55432 (avoids clashes on busy machines).
# Inside Compose network use host `postgres` and port 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/tron_gas_sponsor?schema=public

# TRON Network (mainnet | shasta | nile)
TRON_NETWORK=mainnet
TRON_RPC_URL=https://api.trongrid.io
TRONGRID_API_KEY=

# Legacy single master address (migrated into MasterWallet table on seed).
# Prefer managing multiple receiving wallets in Admin → Master Wallets.
MASTER_TRON_ADDRESS=

# Business rules (also configurable via admin SystemSetting)
MIN_TRX_DEPOSIT=1
# Fixed sponsorship package (ALWAYS both — never resized by user wallet balances)
ENERGY_TARGET=150000
BANDWIDTH_TARGET=1000
PROVIDER_ORDER_MAX_RETRIES=5
TRON_CONFIRMATIONS=20
CONFIRMATIONS_REQUIRED=20
SPONSORSHIP_EXPIRY=24
SPONSORSHIP_EXPIRY_HOURS=24

# Cost control
DAILY_PROVIDER_SPEND_LIMIT=1000
MONTHLY_PROVIDER_SPEND_LIMIT=20000
DAILY_PROVIDER_LIMIT_TRX=1000
MONTHLY_PROVIDER_LIMIT_TRX=20000
MAX_ACTIVE_SPONSORSHIPS=500

# Anti-abuse
MAX_CREDITS_PER_WALLET_PER_DAY=10
MAX_SPONSORSHIPS_PER_IP_PER_DAY=50
MAX_GLOBAL_SPONSORSHIPS_PER_DAY=2000

# Monitoring (only MASTER_TRON_ADDRESS inbound TRX)
TRONGRID_POLL_INTERVAL=6000

# GetGas provider (server-side only — never expose to frontend)
GETGAS_API_KEY=
GETGAS_API_BASE_URL=https://getgas.io/api/v1
GETGAS_WEBHOOK_SECRET=
GETGAS_PROVIDER_TERM=1h
INTERNAL_API_SECRET=

# Admin bootstrap (used once on first seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeSecurely123!

# Security
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECRET=change-me-to-another-long-random-string-32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000

# Worker
WORKER_ENABLED=true
